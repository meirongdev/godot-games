config_version=5

[application]
config/name="Family Game Lobby"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://src/lobby/Login.tscn"

[autoload]
Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
ServerConnection="*res://src/autoload/ServerConnection.gd"

[display]

; ⚠️ 基准分辨率是**竖屏方向**的,这不是笔误。
; canvas_items + expand 的缩放系数是 min(窗口宽/基准宽, 窗口高/基准高)。
;
; 432 = 16 边距 ×2 + 400 内容列。**手机**竖屏的宽高比(0.45~0.56)都低于
; 分界线 432/700 = 0.617,所以一律是宽度受限 —— 逻辑视口恒为 432 宽、
; 内容列恒为 400,算术正好对上,不需要 max-width 逻辑。
; 基准 1280×800 时同一台 390 宽的手机只能缩到 min(390/1280, 844/800) = 0.30,
; 按钮实际高约 18pt(iOS 最小点击目标 44pt),这就是手机上没法用的根因。
;
; ⚠️ 「短边决定缩放」只对手机和横屏成立,**平板竖屏不成立**:
; 宽高比落在 0.617~1.62 之间时是高度受限。iPad 768×1024 的短边是 768,
; 但决定缩放的是高度(scale 1.46)。调基准高度只影响平板和桌面,
; 对手机毫无影响 —— 手机全程由基准宽度 432 决定。
;
; 基准高 700 而不是 640:640 也安全,但会让平板明显偏大(iPad scale 1.60,
; 按钮 70pt+)。700 把 iPad 压到 1.46、桌面 1280×800 压到 1.14
; (逻辑视口 1120×700,400 的列居中约 457px),而分界线 0.617 仍然远高于
; 最方的真机 360×640(0.5625)。不要再往上调:750 会把分界线压到 0.576,
; 贴上 360×640,有把边缘机型翻进未测过的高度受限区的风险。
; 详见 docs/superpowers/specs/2026-08-27-mobile-portrait-design.md §4。
window/size/viewport_width=432
window/size/viewport_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://src/ui/family.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
